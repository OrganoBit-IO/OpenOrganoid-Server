# OpenOrganoid Server Environment Configuration
# Copy this file to .env and update the values for your environment

# Database Configuration
DATABASE_URL=postgresql://openorganoid:openorganoid_dev_password@localhost:5432/openorganoid

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=OpenOrganoid Server
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# File Storage Configuration
STORAGE_PATH=./data/storage
UPLOAD_PATH=./data/uploads
MAX_FILE_SIZE=107374182400  # 100GB in bytes

# DataLad Configuration
DATALAD_PATH=./data/datalad

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Celery Configuration (will use Redis URL if not specified)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Optional: Production settings
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem